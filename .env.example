# Copy to .env and fill in. Never commit .env.

# Postgres (docker compose uses the POSTGRES_* values; apps use DATABASE_URL)
POSTGRES_USER=noise
POSTGRES_PASSWORD=change-me
POSTGRES_DB=noise
DATABASE_URL=postgresql://noise:change-me@localhost:5432/noise

# Models
GEMINI_API_KEY=
# Analyst verdict model (runs the function-calling agent; comparison in analyst/README.md)
GEMINI_MODEL=gemini-4-hydrogen
# Cheap model for bulk single-shot verdicts (clusters the detector calls likely_organic)
GEMINI_BATCH_MODEL=gemini-3.5-flash-lite
# Gemini function calling into sources/ (Oxylabs) + DB lookups, and its per-cluster budget
ANALYST_TOOLS=true
ANALYST_MAX_TOOL_CALLS=6
ANALYST_MAX_WEB_CALLS=4
ANALYST_TIME_BUDGET_S=120
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Nemotron 3.5 Super VL for media/: the dedicated Verda endpoint wins when its key is set
VERDA_INFERENCE_KEY=
VERDA_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
VERDA_MODEL=nemotron-3.5-super-vl
# media/ worker: statuses to read (priority order), min score, unique media per cluster, rate limit
MEDIA_STATUSES=coordinated,insufficient
MEDIA_MIN_SCORE=0.5
MEDIA_MAX_PER_CLUSTER=4
MEDIA_RPM=30
MEDIA_MAX_TOKENS=4096
MEDIA_REASONING=true

# Sources
# Oxylabs Web API key (Bearer token; webapi.oxylabs.io/v1/search and /scrape)
OXYLABS_WEB_API_KEY=
CONTEXT_DEV_API_KEY=

# Bluesky Jetstream (public, no key)
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
# Optional: comma-separated failover hosts (default: jetstream{1,2}.us-{east,west}.bsky.network)
JETSTREAM_HOSTS=
# Raw event retention in hours (posts/reposts/follows; likes can be shorter). Clusters are kept forever.
INGEST_RETENTION_HOURS=48
INGEST_LIKES_RETENTION_HOURS=
# Optional: tee raw Jetstream events to hourly gzip files here (for replay/eval), pruned after N hours
INGEST_RECORD_DIR=
INGEST_RECORD_KEEP_HOURS=24

# Hostinger deploy
HOSTINGER_HOST=
HOSTINGER_USER=
PUBLIC_DOMAIN=
# On the Hostinger VPS (deploy/docker-compose.hostinger.yml): hostname Traefik routes to us
PUBLIC_HOST=noise-radar.srv2159172.hstgr.cloud

# Link lookup (POST /api/lookup, lookup/README.md): budgets for live Oxylabs/Nemotron/Gemini calls
LOOKUP_MAX_PER_HOUR=60
LOOKUP_MAX_PER_IP_PER_HOUR=10
LOOKUP_CACHE_TTL_S=1800
LOOKUP_VERIFY_MAX=8
LOOKUP_PROFILES_MAX=4
LOOKUP_TIME_BUDGET_S=150
LOOKUP_MEDIA=true
LOOKUP_GEMINI=true
