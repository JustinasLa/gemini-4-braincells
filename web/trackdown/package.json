{
  "name": "shill-or-chill-trackdown",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test ../../tests/test_trackdown_findings.mjs ../../tests/test_trackdown_graph.mjs ../../tests/test_trackdown_labels.mjs ../../tests/test_trackdown_shared.mjs ../../tests/test_trackdown_panelwidth.mjs",
    "dev": "vite --host 0.0.0.0 --port 3001",
